# PostgreSQL 연결 문자열 (Render Postgres의 External/Internal Database URL)
DATABASE_URL="postgresql://user:password@host:5432/jibnote"

JWT_SECRET="change-me-to-a-random-string"
PORT=4001

# Cloudinary (cloudinary.com 무료 가입 후 Dashboard에서 확인)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Gemini (aistudio.google.com/apikey 에서 무료 발급 - 캡처 이미지 자동 인식용)
GEMINI_API_KEY=""
