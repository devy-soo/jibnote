generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  preferences  String    @default("{}")
  createdAt    DateTime  @default(now())
  listings     Listing[]
}

model Listing {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                  String
  listingNumber          String?
  platform               String?
  sourceUrl              String?
  buildingType           String?
  dealType               String
  deposit                Int      @default(0)
  monthlyRent            Int?
  areaSqm                Float?
  rooms                  Int?
  floorNumber            Int?
  direction              String?
  totalFloors            Int?
  approvalDate           String?
  isViolationBuilding    Boolean?
  isFakeListing          Boolean?
  parkingAvailable       Boolean?
  options                String   @default("[]")
  maintenanceFee         Int?
  maintenanceFeeIncludes String   @default("[]")
  walkMinutes            Int?
  nearestStation         String?
  address                String?
  agents                 String   @default("[]")
  memo                   String?
  tags                   String   @default("[]")
  status                 String   @default("관심")
  saved                  Boolean  @default(true)
  checklist              String   @default("{}")
  ratings                String   @default("{}")
  visitNote              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  photos                 Photo[]

  @@index([userId])
}

model Photo {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}
